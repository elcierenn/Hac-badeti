{
  "expo": {
    "name": "Hac İbadeti",
    "slug": "hac-ibadeti",
    "scheme": "hac-ibadeti",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_square.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/hac_ibadetianasayfa.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hacibadeti.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Konumunuz, Kabe'nin bulunduğu yönü (kıble) hesaplamak ve size en doğru kıble yönünü göstermek için kullanılır. Konum bilgisi yalnızca uygulama açıkken kullanılır ve hiçbir sunucuya gönderilmez.",
        "NSMotionUsageDescription": "Pusula sensörü, cihazınızın yönünü belirleyerek Kabe'nin tam yönünü (kıble) ekranda göstermek için kullanılır."
      }
    },
    "android": {
      "package": "com.hacibadeti.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon_square.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/hac_ibadetianasayfa.png"
    },
    "plugins": [
      "expo-localization",
      "expo-router",
      "./plugins/withRemoveActivityRecognition",
      "./plugins/withFixAndroidPackage",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9331428503808272~5045683397",
          "iosAppId": "ca-app-pub-9331428503808272~4567857000"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Bu izin, size daha uygun reklamlar gösterilmesine ve uygulamanın ücretsiz kalmasına yardımcı olur."
        }
      ],
      "react-native-iap"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e01b123e-f21a-409a-8561-73a67a099db7"
      }
    },
    "owner": "ball-l",
    "updates": {
      "url": "https://u.expo.dev/e01b123e-f21a-409a-8561-73a67a099db7"
    }
  }
}
